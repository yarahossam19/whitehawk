# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# Production values belong in the GitLab `APP_ENV_FILE` variable, which
# .gitlab-ci.yml copies to the EC2 host and passes via `docker run --env-file`.

# ---------- Supabase ----------
# Server-only pair (used by src/lib/posts.ts, contact.actions.ts).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Browser pair (used by the Supabase SSR clients and middleware).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PROJECT_ID=

# ---------- Demo request form ----------
# Where demo notifications are delivered.
DEMO_RECIPIENT_EMAIL=ali.elsawy@whiteguard.co.uk
# From: header. Falls back to "WhiteHawk Website <info@whiteguard.co.uk>".
MAIL_FROM=WhiteHawk Website <info@whiteguard.co.uk>
# Signs/encrypts captcha tokens. MUST be set in production — the built-in
# fallback ("dev-only-default-change-me") makes tokens forgeable.
CAPTCHA_SECRET=

# ---------- Mail transport: SMTP ----------
# Used when the M365_* block below is not fully configured.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# "true" only for implicit TLS (port 465); 587 uses STARTTLS, so leave false.
SMTP_SECURE=false
SMTP_USER=info@whiteguard.co.uk
SMTP_PASS=

# ---------- Mail transport: Microsoft Graph (preferred when set) ----------
# Takes precedence over SMTP. Use this if the tenant has SMTP AUTH disabled.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER_EMAIL=info@whiteguard.co.uk
